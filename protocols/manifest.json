{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/galeri-coder/ilhanart-core/main/protocols/poart-identity-v1.json",
  "title": "[PoArt] Identity Manifest Schema",
  "description": "Official schema for İlhan Art Proof of Art Identity Manifests",
  "type": "object",
  "required": ["manifest", "identity", "asset_data", "philosophy", "official_links"],
  "properties": {
    "manifest": { "type": "object" },
    "identity": { "type": "object" },
    "asset_data": { 
      "type": "object",
      "properties": {
        "fingerprints": {
          "type": "object",
          "properties": {
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" }
          }
        }
      }
    },
    "philosophy": { "type": "object" },
    "official_links": { "type": "object" }
  }
}
